# ── VCG Website — Environment Variables (copy to .env.local and fill in values) ──
# Do NOT commit .env.local to version control.

# ── Microsoft Graph — OAuth2 Client Credentials ────────────────────────────────
# Azure portal → Microsoft Entra ID → App registrations → [VCG Website Mailer]
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Sending mailbox (must be registered in Exchange Online RBAC for this app)
GRAPH_SENDER_ADDRESS=info@vayuconsultinggroup.com

# ── Email Destinations ──────────────────────────────────────────────────────────
# Where contact form submissions are delivered.
CONTACT_EMAIL=info@vayuconsultinggroup.com

# Where talent / join form submissions are delivered.
CAREERS_EMAIL=info@vayuconsultinggroup.com
